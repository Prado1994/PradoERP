<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Launch screen moderna (necessária para o app usar a tela inteira e
         respeitar corretamente a orientação Paisagem) -->
    <key>UILaunchScreen</key>
    <dict/>

    <!-- Permissões de privacidade exigidas pelos recursos do app -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Usamos sua localização apenas para exibir a velocidade atual no velocímetro enquanto você dirige.</string>

    <key>NSAppleMusicUsageDescription</key>
    <string>Precisamos de acesso à sua biblioteca de mídia para exibir e controlar a música em reprodução.</string>

    <!-- Modo Paisagem (Landscape) obrigatório -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Esconde a barra de status para um visual de central multimídia -->
    <key>UIStatusBarHidden</key>
    <true/>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>

    <!-- URL Schemes consultados via canOpenURL (apps de navegação e Spotify) -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>waze</string>
        <string>comgooglemaps</string>
        <string>spotify</string>
    </array>

    <!-- URL scheme próprio para receber o callback de login do Spotify -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.pradocalcados.smartdashboard</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>smartdashboard</string>
            </array>
        </dict>
    </array>

    <!-- Permite reprodução/atualização de áudio em segundo plano -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
</dict>
</plist>
