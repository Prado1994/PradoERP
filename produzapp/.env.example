# Porta da API
PORT=3000

# Chaves de acesso à API (uma por cliente: estação, painel, integradores), separadas por vírgula.
# Gere chaves longas e aleatórias. NUNCA coloque chaves reais no repositório.
API_KEYS=troque-esta-chave-de-desenvolvimento

# Carrega OPs de demonstração ao iniciar (1 = sim)
SEED=0

# Regras de leitura
BLOQUEAR_FORA_DE_SEQUENCIA=1
PARES_PADRAO_POR_CAIXA=20

# Integrações (preencher só na fase de conectores; tokens ficam apenas no servidor)
# BLING_CLIENT_ID=
# BLING_CLIENT_SECRET=
# ODOO_URL=
# ODOO_DB=
# ODOO_USER=
# ODOO_API_KEY=

# Banco PostgreSQL. Sem esta variável a API usa memória (só desenvolvimento).
# Neon/Vercel: use a URL com ?sslmode=require. Nunca commite o valor real.
# DATABASE_URL=postgres://usuario:senha@host:5432/produzapp
# MIGRAR_AO_INICIAR=0   # desligue se a migração for rodada à parte (npm run migrar)

# Só para os testes de repositório (o banco é ESVAZIADO a cada teste — use um banco descartável)
# DATABASE_URL_TESTE=postgres://produzapp:dev@localhost:5432/produzapp_teste

# Só para docker-compose.yml
# POSTGRES_PASSWORD=
# DOMINIO=producao.pradocalcados.com.br

# Bling (pedidos de venda -> caixa de entrada). Crie um aplicativo no Bling (Central de Extensões) e autorize com: npm run bling:autorizar
# BLING_CLIENT_ID=
# BLING_CLIENT_SECRET=
# BLING_SITUACOES_IMPORTAR=6     # IDs de situação (da SUA conta) que entram na caixa. 6 = Em aberto em Itanhandu
# BLING_SITUACOES_CANCELADO=12   # 12 = Cancelado em Itanhandu
# BLING_IMPORTAR_DESDE=2026-10-01   # primeira carga; depois só o que mudou
