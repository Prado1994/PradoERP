# URL do projeto Supabase do SouCrum
SOUCRUM_SUPABASE_URL=https://sbyivwkcvjkropoforqx.supabase.co

# Chave de acesso. Duas opções:
#  - service_role (Dashboard > Settings > API): acesso TOTAL, ignora RLS.
#    Use somente em ambiente confiável (sua máquina). NUNCA exponha no navegador.
#  - anon/publishable + SOUCRUM_USER_JWT: respeita RLS, acesso restrito ao usuário.
SOUCRUM_SUPABASE_KEY=

# Opcional: JWT de um usuário logado, para operar respeitando RLS com a chave anon.
# SOUCRUM_USER_JWT=

# Opcional: trava o servidor em modo somente-leitura ("true" desativa as ferramentas de escrita)
# SOUCRUM_READ_ONLY=false
