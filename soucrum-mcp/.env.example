# URL do projeto Supabase do SouCrum
SOUCRUM_SUPABASE_URL=https://sbyivwkcvjkropoforqx.supabase.co

# Chave de acesso. Duas opções:
#  - service_role (Dashboard > Settings > API): acesso TOTAL, ignora RLS.
#    Use somente em ambiente confiável (sua máquina). NUNCA exponha no navegador.
#  - anon/publishable + SOUCRUM_USER_JWT: respeita RLS, acesso restrito ao usuário.
SOUCRUM_SUPABASE_KEY=

# Opcional: JWT de um usuário logado, para operar respeitando RLS com a chave anon.
# SOUCRUM_USER_JWT=

# Opcional: trava o servidor em modo somente-leitura ("true" desativa as ferramentas de escrita)
# SOUCRUM_READ_ONLY=false

# Opcional: expõe GET /health em 127.0.0.1 para a tela de Configurações do SouCrum
# mostrar o status real (versão, modo, ferramentas ativas, conexão com o banco).
# Só metadados — não devolve chave nem dado de negócio. Sem esta variável, nada é aberto.
# SOUCRUM_HTTP_PORT=7757

# Origens remotas autorizadas a ler o /health (separadas por vírgula).
# Qualquer porta de http://localhost e http://127.0.0.1 já é aceita por padrão.
# SOUCRUM_HTTP_ALLOWED_ORIGINS=https://soucrum.vercel.app

# ---------------------------------------------------------------------------
# Notificações — configure só os canais que quiser usar
# ---------------------------------------------------------------------------

# Slack: Apps > seu app > Incoming Webhooks > Add New Webhook to Workspace
# SOUCRUM_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx

# Google Chat: abra o Espaço > nome do espaço > Apps e integrações > Webhooks
# SOUCRUM_GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/AAAA/messages?key=...&token=...

# Microsoft Teams: no canal, Workflows > "Post to a channel when a webhook
# request is received". Os conectores antigos do Office 365 foram descontinuados,
# por isso enviamos Adaptive Card.
# SOUCRUM_TEAMS_WEBHOOK_URL=https://prod-00.brazilsouth.logic.azure.com:443/workflows/...

# E-mail via Resend (https://resend.com/api-keys). Remetente precisa de domínio
# verificado. Vários destinatários separados por vírgula.
# SOUCRUM_RESEND_API_KEY=re_xxxxxxxx
# SOUCRUM_EMAIL_FROM=soucrum@seudominio.com.br
# SOUCRUM_EMAIL_TO=voce@empresa.com,equipe@empresa.com
# SOUCRUM_RESEND_API_URL=https://api.resend.com/emails   # troque só se usar proxy

# Link que aparece no botão "Abrir no SouCrum" das notificações
# SOUCRUM_APP_URL=https://soucrum.vercel.app
